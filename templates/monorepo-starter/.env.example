# Environment Configuration
NODE_ENV=development

# Database (PostgreSQL)
DB_USER=appuser
DB_PASSWORD=apppassword123
DB_NAME=appdb
DB_PORT=5432
DATABASE_URL=postgresql://appuser:apppassword123@localhost:5432/appdb?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass123

# JWT & Security
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_EXPIRES_IN=7d

# API & Frontend URLs
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
